# =====================================================================
# MODÈLE DE FICHIER DE RÉGLAGES (sans vraie clé).
# Copie ce fichier sous le nom  .env  (dans le même dossier "serveur"),
# puis remplace les valeurs. Le fichier .env ne part JAMAIS sur GitHub.
# =====================================================================

# Ta clé Higgsfield a deux parties : un identifiant et un secret.
# Elles s'affichent une seule fois quand tu crées la clé dans ta console.
HIGGSFIELD_KEY_ID=colle-ici-ton-identifiant
HIGGSFIELD_KEY_SECRET=colle-ici-ton-secret

# Plafonds de crédits (le serveur refuse au-delà)
MAX_VIDEOS_PAR_JOUR=3
MAX_VIDEOS_PAR_SESSION=2

# Mettre 1 pour TESTER sans appeler Higgsfield (aucun coût, vidéo fictive).
# Mettre 0 (ou supprimer la ligne) pour utiliser le vrai service.
MODE_SIMULATION=1

# Réglages avancés (ne change rien si tu n'es pas sûr)
PORT=3000
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
