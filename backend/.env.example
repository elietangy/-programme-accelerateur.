PORT=4000
NODE_ENV=development
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=5
# Dossier de stockage des données (base SQLite + justificatifs). En production,
# pointez ceci vers le volume/disque persistant fourni par votre hébergeur.
DB_DIR=./data
