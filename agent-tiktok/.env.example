# Copie ce fichier sous le nom .env. Il ne part JAMAIS sur GitHub. Ne colle jamais ces valeurs dans un chat.

# SÉCURITÉ : 1 = simulation (rien n'est dépensé ni publié). Mets 0 seulement quand tout est prêt.
MODE_SIMULATION=1
# auto = publie seul. validation = prépare la vidéo et attend « node agent.js approuver <id> ».
MODE_PUBLICATION=auto

# Quand publier (heures locales du fuseau ci-dessous)
FUSEAU=Africa/Porto-Novo
HEURES_PUBLICATION=12:00,18:30

# Plafonds (l'agent s'arrête dès qu'un plafond est atteint)
MAX_VIDEOS_PAR_JOUR=2
MAX_DEPENSE_PAR_JOUR_USD=5
# Prix par seconde de vidéo lu dans ta console Higgsfield. OBLIGATOIRE en mode réel.
PRIX_PAR_SECONDE_USD=0
DUREE_VIDEO_SECONDES=15
RESOLUTION=720p

# Écriture des scripts (Claude). Sans clé : modèles de texte intégrés.
ANTHROPIC_API_KEY=
# Génération vidéo (Higgsfield)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=

# TikTok (portail développeur TikTok, produit « Content Posting API »)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Passer à 1 seulement après l'audit TikTok de l'application (sinon vidéos privées uniquement)
TIKTOK_AUDITE=0
